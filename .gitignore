# macOS
.DS_Store
._*

# Local editor settings
.idea/
.vscode/
*.swp
*.swo
*~

# Environment variables and local secrets
.env
.env.*
!.env.example
!.env.*.example

# Frontend dependencies and build output
node_modules/
.pnpm-store/
/apps/client/dist/
/apps/client/build/
/apps/client/.taro/
/apps/client/.cache/
*.tsbuildinfo

# Go build output and development tools
/services/api/bin/
/services/api/tmp/
*.test
coverage.out

# Test reports
coverage/
playwright-report/
test-results/

# Logs
*.log

# Legacy runtime locations (keep ignored to prevent accidental recommits)
/services/api/data/
/services/api/uploads/
/deploy/data/

__pycache__
/evals/.venv/
/evals/output/

/evals/.venv-server/

# Actual local configuration, credentials, private inputs and persistent state
/local/

# Generated builds, deployment packages, eval results and reports.
# These may contain credentials or private chat excerpts; never commit them.
/outputs/

# Legacy private evaluation locations
/evals/cases.json
/evals/chat-cases-review.md
/evals/versions/

# Legacy API deployment artifacts (prevent accidental commits)
/deploy/api/api-linux-*
/deploy/api/api-deploy.tar.gz
/deploy/api/models.example.json
/deploy/api/SHA256SUMS
/deploy/api/.build-*/
