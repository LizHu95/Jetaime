[Unit]
Description=Jetaime Phoenix trace collector
After=network.target

[Service]
User=phoenix
Group=phoenix
WorkingDirectory=/var/lib/jetaime-phoenix
Environment=PHOENIX_WORKING_DIR=/var/lib/jetaime-phoenix
Environment=PHOENIX_HOST=127.0.0.1
Environment=PHOENIX_PORT=6006
Environment=PHOENIX_HOST_ROOT_PATH=/page/phoenix
Environment=PHOENIX_GRPC_PORT=4317
Environment=PHOENIX_TELEMETRY_ENABLED=false
Environment=PHOENIX_ALLOW_EXTERNAL_RESOURCES=false
Environment=PHOENIX_ALLOWED_SANDBOX_PROVIDERS=NONE
ExecStart=/opt/jetaime-phoenix/bin/phoenix serve
Restart=on-failure
RestartSec=5
MemoryHigh=600M
MemoryMax=800M
NoNewPrivileges=true
PrivateTmp=true
IPAddressDeny=any
IPAddressAllow=localhost
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jetaime-phoenix

[Install]
WantedBy=multi-user.target
