# Create a project in Langfuse Cloud and generate project API keys.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
OTEL_SERVICE_NAME=jetaime-api
# true includes model messages/replies (each attribute bounded to 64 KiB).
JETAIME_TRACE_CAPTURE_CONTENT=true
# Optional: sample whole traces consistently; default is parentbased_always_on.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.5
# OTEL_SDK_DISABLED=true
