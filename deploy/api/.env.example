# Save actual values in local/.env; api-build copies it into the deployment package.
# start.sh loads the packaged .env for start and migrate (Bash assignment syntax).
# Use your own credentials and database; no real secrets belong in the repository.
JETAIME_DATABASE_URL='postgres://jetaime:replace-me@127.0.0.1:5432/jetaime?sslmode=disable'

# Shared group AI is enabled by default; package local/models.json with a callable cloud profile.
# Optional override; defaults to models.json beside start.sh.
# JETAIME_MODEL_CONFIG='/etc/jetaime/models.json'

# Generate once with go run ./cmd/webpush-keygen; keep keys stable and private.
JETAIME_WEB_PUSH_ENABLED='false'
JETAIME_WEB_PUSH_PUBLIC_KEY=''
JETAIME_WEB_PUSH_PRIVATE_KEY=''
JETAIME_WEB_PUSH_SUBJECT='https://101.132.186.29/page/'

# Memory workers start automatically with the production API.
# Configure local/memory.json and model credentials before startup; no enabled flag.
# JETAIME_MEMORY_CONFIG='/etc/jetaime/memory.json'

# Optional same-host Phoenix trace collector.
# JETAIME_PHOENIX_TRACES_ENDPOINT=http://127.0.0.1:6006/v1/traces
