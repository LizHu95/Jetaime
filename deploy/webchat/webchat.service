[Unit]
Description=Jetaime Web Chat
After=network.target

[Service]
User=webchat
Group=webchat
WorkingDirectory=/opt/jetaime-webchat
EnvironmentFile=/etc/jetaime-webchat.env
ExecStart=/opt/jetaime-webchat/webchat -assistant=false -webchat -addr 127.0.0.1:8082 -webchat-state /var/lib/jetaime-webchat/state.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/jetaime-webchat

[Install]
WantedBy=multi-user.target
