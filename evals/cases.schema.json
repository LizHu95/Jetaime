{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jetaime V2 Workflow evaluation cases",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "input"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture",
          "groupId",
          "actorId",
          "kind"
        ],
        "properties": {
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "users",
              "groups",
              "members",
              "messages"
            ],
            "properties": {
              "users": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "nickname"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nickname": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "groupId",
                    "userId"
                  ],
                  "properties": {
                    "groupId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "userId": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "groupId",
                    "senderId",
                    "sentAt",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "groupId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "senderId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sentAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "messages",
              "tasks"
            ],
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "groupId",
                    "senderId",
                    "sentAt",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "groupId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "senderId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sentAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "groupId",
                    "title",
                    "assigneeId",
                    "dueAt",
                    "status",
                    "sourceMessageIds",
                    "confirmationKey"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "groupId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "assigneeId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dueAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "status": {
                      "enum": [
                        "pending",
                        "completed"
                      ]
                    },
                    "sourceMessageIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "confirmationKey": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "groupId": {
            "type": "string",
            "minLength": 1
          },
          "actorId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "qa",
              "extract"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "qa"
                }
              }
            },
            "then": {
              "required": [
                "question"
              ]
            }
          }
        ]
      },
      "expected": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewed"
        ],
        "properties": {
          "reviewed": {
            "type": "boolean"
          },
          "workflowStatus": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "answerStatus": {
            "enum": [
              "answered",
              "insufficient_evidence",
              "conflicting_evidence"
            ]
          },
          "requiredSourceMessageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "forbiddenSourceMessageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "suggestionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "reference": {
            "type": "object",
            "description": "人工参考答案/行动清单，供语义评估；保留原文或结构化内容。"
          },
          "notes": {
            "type": "string"
          },
          "requiredSuggestions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "titleContains"
              ],
              "properties": {
                "titleContains": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "assigneeId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timeExpression": {
                  "type": "string"
                },
                "requiredSourceMessageIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "forbiddenSuggestions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "titleContains"
              ],
              "properties": {
                "titleContains": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "assigneeId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timeExpression": {
                  "type": "string"
                },
                "requiredSourceMessageIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      },
      "metadata": {
        "type": "object"
      }
    }
  }
}
